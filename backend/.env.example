# ==========================================================================
# Backend — IASD Gestão. Copie para backend/.env e ajuste.
# NÃO comite o .env real. Em dev você pode rodar sem nenhum .env (os defaults
# bastam: SQLite + DEBUG ligado).
# ==========================================================================

# --- Geral ---
# Gere uma nova com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
# true em dev, false em produção
DJANGO_DEBUG=true
# Hosts liberados em produção (separados por vírgula).
# No PythonAnywhere: seu-usuario.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Sao_Paulo

# --- Banco de dados (SQLite, padrão do Django) ---
# Opcional: caminho absoluto do arquivo .sqlite3 (útil no PythonAnywhere).
# DB_PATH=/home/SEU_USUARIO/SITE-IASD/backend/db.sqlite3

# --- JWT ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# --- CORS / CSRF (frontend) ---
# Em dev o Vite faz proxy, então não precisa mexer.
# Em produção, libere o domínio do Vercel:
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Ex. prod: https://seu-app.vercel.app
CSRF_TRUSTED_ORIGINS=

# --- Produção (quando DJANGO_DEBUG=false) ---
# SECURE_SSL_REDIRECT=false   # PythonAnywhere já faz HTTPS na borda
# SECURE_HSTS_SECONDS=0
