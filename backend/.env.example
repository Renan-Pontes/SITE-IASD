# ==========================================================================
# Backend — IASD Gestão. Copie para .env e ajuste. NÃO comite o .env real.
# Em dev você pode rodar sem nenhum .env (os defaults bastam com SQLite).
# ==========================================================================

# --- Geral ---
# Gere uma nova com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
# true em dev, false em produção
DJANGO_DEBUG=true
# Hosts liberados em produção (separados por vírgula)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Sao_Paulo

# --- Banco de dados ---
# sqlite (dev) ou mysql (produção)
DB_ENGINE=sqlite
# Usados apenas quando DB_ENGINE=mysql:
DB_NAME=iasd
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# --- JWT ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# --- CORS (frontend) ---
# Em dev o Vite faz proxy, então normalmente não precisa mexer.
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
